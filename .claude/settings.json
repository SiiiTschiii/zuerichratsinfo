{
  "hooks": {
    "PostToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "if": "Bash(gh pr create *)",
            "command": "\"$CLAUDE_PROJECT_DIR\"/.claude/hooks/pr-nudge.sh opened",
            "timeout": 30,
            "statusMessage": "Opening the PR review cycle"
          },
          {
            "type": "command",
            "if": "Bash(git push *)",
            "command": "\"$CLAUDE_PROJECT_DIR\"/.claude/hooks/pr-nudge.sh pushed",
            "timeout": 30,
            "statusMessage": "Checking the pull request"
          }
        ]
      }
    ]
  }
}
